# Optional overrides: copy this file to .env to customize Docker Compose.
# gRPC address inside the Compose network (host:port, without a URL scheme).
TRITON_URL=triton:8001
TRITON_MODEL_NAME=recommender_onnx

# Existing JSON file on the host, from the same training run as model.onnx.
# Relative paths are resolved from the directory containing docker-compose.yml.
VOCABULARY_HOST_PATH=./artifacts/vocabulary.json
