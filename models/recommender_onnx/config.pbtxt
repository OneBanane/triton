name: "recommender_onnx"
platform: "onnxruntime_onnx"
max_batch_size: 0

input [
  {
    name: "user_id"
    data_type: TYPE_INT64
    dims: [ -1 ]
  },
  {
    name: "movie_id"
    data_type: TYPE_INT64
    dims: [ -1 ]
  },
  {
    name: "genres"
    data_type: TYPE_INT64
    dims: [ -1, -1 ]
  }
]

output [
  {
    name: "output"
    data_type: TYPE_FP32
    dims: [ -1 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_CPU
  }
]
