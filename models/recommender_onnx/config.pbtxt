name: "recommender_onnx"
platform: "onnxruntime_onnx"
max_batch_size: 32

dynamic_batching {
  max_queue_delay_microseconds: 1000
}

input [
  {
    name: "user_id"
    data_type: TYPE_INT64
    dims: [ 1 ]
    reshape { shape: [] }
  },
  {
    name: "movie_id"
    data_type: TYPE_INT64
    dims: [ 1 ]
    reshape { shape: [] }
  },
  {
    name: "genres"
    data_type: TYPE_INT64
    dims: [ -1 ]
  }
]

output [
  {
    name: "output"
    data_type: TYPE_FP32
    dims: [ 1 ]
    reshape { shape: [] }
  }
]

instance_group [
  {
    count: 1
    kind: KIND_CPU
  }
]
